# ==============================================================================
# SafeSignal Monorepo Environment Configuration Example
# Copy this to .env (or configure in your cloud hosting provider dashboard)
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client)
# ------------------------------------------------------------------------------
# URL of the backend API (set this in your static host e.g. Vercel/Netlify/Render)
VITE_API_BASE_URL=https://api.yourdomain.com/api
# Or alternative alias supported in code:
# VITE_API_URL=https://api.yourdomain.com/api

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Node.js / Express API)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# Comma-separated list of allowed frontend origins for CORS (HTTPS required in production)
CLIENT_ORIGIN=https://safesignal.yourdomain.com,https://your-frontend.vercel.app

# Production Session Secret (Generate a cryptographically random string >= 32 characters)
# e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_SECRET_HEX

# Cookie Settings
# Use 'none' for cross-domain hosting (e.g. frontend on Vercel, API on Render)
# Use 'lax' if frontend and API share the same root domain
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Managed MySQL 8.0)
# ------------------------------------------------------------------------------
DB_HOST=your-mysql-hostname.provider.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=safesignal_prod
# Set DB_SSL=true for managed cloud databases (PlanetScale, Aiven, AWS RDS, Render, etc.)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 4. PRIVATE OBJECT STORAGE (Image Uploads)
# ------------------------------------------------------------------------------
# Set to 's3' for production (AWS S3, Cloudflare R2, MinIO, or DigitalOcean Spaces)
# Set to 'local' for development / persistent disk volumes
STORAGE_DRIVER=s3

# S3-compatible cloud storage settings (required if STORAGE_DRIVER=s3)
S3_REGION=us-east-1
S3_BUCKET=safesignal-private-evidence
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
# Optional custom S3 endpoint (leave empty for AWS S3, set for Cloudflare R2 or MinIO)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Local Storage Directory (used only if STORAGE_DRIVER=local)
STORAGE_LOCAL_PATH=../storage/uploads

# ------------------------------------------------------------------------------
# 5. FIRST ADMINISTRATOR SETUP (Optional CLI automated creation)
# ------------------------------------------------------------------------------
# If running 'npm run create-admin' in non-interactive environments:
# ADMIN_USERNAME=safety_director
# ADMIN_EMAIL=director@safesignal.org
# ADMIN_PASSWORD=ReplaceWithStrongPassword10Chars!

# ------------------------------------------------------------------------------
# 6. APPLICATION OPERATIONAL DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_ALERT_THRESHOLD=5
DEFAULT_ALERT_WINDOW_HOURS=24
DATA_RETENTION_DAYS=365

# Rate Limits (Abuse protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REPORTS=30
RATE_LIMIT_MAX_AUTH=10
